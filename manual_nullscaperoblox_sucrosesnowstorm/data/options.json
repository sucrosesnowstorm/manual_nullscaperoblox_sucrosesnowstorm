{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "_comment":{
            "display_name": "Goal Level",
            "description": "What level you need to reach to win this APworld",
            "values": {"Level 10": 0, "Level 15":  1, "Level 20": 2},
            "type": "Choice",
            "default": 1,
            "hidden": false
        }
    },
    "user": {
        "starting class":{
            "description": [
                "Choose which class the player starts with"
            ],
            "values": {
                "Prisoner":0,
                "Wanted":1,
                "Charger":2,
                "Glider":3,
                "Grappler":4,
                "Spirit":5,
                "Diver":6
            },
            "display_name": "Starting Class",
            "type": "Choice",
            "default": 0,
            "allow_custom_value": false,
            "group": "Class Options"
        },
        "randomize lategame upgrades": {  
            "description": [
                "By default, all obtainable upgrades are randomized as Seeds. Disable to exclude upgrades that only appear at Level 15 or later."
            ],
            "display_name": "Randomize Lategame Upgrades",
            "type": "Toggle"
        },
        "total blossom fragments": {
            "description": [
                "How many Blossom Fragments are in the multiworld."
            ],
            "display_name": "Total Blossom Fragments",
            "type": "Range",
            "default": 30,
            "range_start": 0,
            "range_end": 40,
            "group": "Goal Options"
        },
        "blossom fragments required": {
            "description": [
                "How many Blossom Fragments are required to goal. (Recommened to be 10 less than total)"
            ],
            "display_name": "Blossom Fragments Required",
            "type": "Range",
            "default": 20,
            "range_start": 0,
            "range_end": 40,
            "group": "Goal Options"
        },
        "goal":{
            "display_name": "Goal Type",
            "description": "What do you need to do to win this APworld",
            "alias": {
                "Reach Level 10": 1, 
                "Reach Level 15": 2, 
                "Reach Level 20": 3 
            },
            "type": "Choice",
            "default": 1,
            "hidden": false,
            "group": "Goal Options"
        },
        "randomize roots": {
            "description": [
                "Randomizes Each Classes' Roots, which are required for a class to goal"
            ],
            "display_name": "Randomize Roots",
            "type": "Toggle",
            "default": 1,
            "group": "Goal Options"
        },
        "randomize lower difficulty": {
            "description": [
                "Randomizes the Progressive Lower Difficulties. When enabled, the player starts on Extreme, and can lower difficuilty when items are"
            ],
            "display_name": "Randomize Progessive Lower Difficulty",
            "type": "Toggle",
            "default": 1
        }
        
    }
    

}
