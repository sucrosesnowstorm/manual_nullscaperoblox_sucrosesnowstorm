{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "_comment":{
            "display_name": "Goal Level",
            "description": "What level you need to reach to goal.",
            "values": {"Level 10": 0, "Level 15":  1, "Level 20": 2},
            "type": "Choice",
            "default": 1,
            "hidden": false
        }
    },
    "user": {
        "starting class":{
            "description": [
                "Choose which class the player starts with."
            ],
            "values": {
                "prisoner":0,
                "wanted":1,
                "charger":2,
                "glider":3,
                "grappler":4,
                "spirit":5,
                "diver":6
            },
            "display_name": "Starting Class",
            "type": "Choice",
            "default": 0,
            "allow_custom_value": false,
            "group": "Class Options"
        },
        "randomize lategame upgrades": {  
            "description": [
                "By default, all obtainable upgrades are randomized as Seeds. Disable to exclude upgrades that only appear at Level 15 or later. Upgrades excluded by this option are written in italics in the Item Codex."
            ],
            "display_name": "Randomize Lategame Upgrades",
			"default": 1,
            "type": "Toggle"
        },
        "total blossom fragments": {
            "description": [
                "How many FRAGMENT OF BLOSSOM are randomized."
            ],
            "display_name": "Total FRAGMENT OF BLOSSOM",
            "type": "Range",
            "default": 30,
            "range_start": 0,
            "range_end": 40,
            "group": "Goal Options"
        },
        "blossom fragments required": {
            "description": [
                "How many FRAGMENT OF BLOSSOM are required to goal. (Recommened to be ~10 less than total)."
            ],
            "display_name": "FRAGMENT OF BLOSSOM required",
            "type": "Range",
            "default": 20,
            "range_start": 0,
            "range_end": 40,
            "group": "Goal Options"
        },
        "goal":{
            "display_name": "Goal Type",
            "description": "What do you need to do to win this APWorld, once meeting all other requirements.",
            "alias": {
                "Reach Level 10": 1, 
                "Reach Level 15": 2, 
                "Reach Level 20": 3 
            },
            "type": "Choice",
            "default": 1,
            "hidden": false,
            "group": "Goal Options"
        },
        "randomize roots": {
            "description": [
                "Include a ROOTS item for each class, which are a requirement for a class to goal. See summary and Item Codex for more info."
            ],
            "display_name": "Randomize ROOTS",
            "type": "Toggle",
            "default": 1,
            "group": "Goal Options"
        },
        "randomize lower difficulty": {
            "description": [
                "Adds 2 'Progressive Lower Difficulty's. When included, the player starts on Extreme, and can lower difficulty when the items are collected."
            ],
            "display_name": "Randomize Difficulty Selection",
            "type": "Toggle",
            "default": 1
        }
    }
}
